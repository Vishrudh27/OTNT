# Copy this file to .env and adjust for your environment.
# .env is gitignored; this example file is the only one tracked in git.

# Port the Express API listens on.
PORT=3001

# Redis/Valkey connection string.
REDIS_URL=redis://127.0.0.1:6379

# Comma-separated list of allowed CORS origins (no spaces needed, but
# whitespace around commas is trimmed). Add your frontend's dev and/or
# deployed origin(s) here.
CORS_ORIGINS=http://localhost:5173,http://192.168.29.17:5173
